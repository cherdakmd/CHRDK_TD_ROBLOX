          <Item class="ModuleScript" referent="RBX18">
            <Properties>
              <string name="Name">Profiles</string>
              <ProtectedString name="Source">-- Fail-closed persistence: a failed load is never later written over real data.
-- Only account progression is saved. Match gold and towers are intentionally temporary.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local STORE_NAME = "CHRDK_TD_Profile_v1"
local LOCK_SECONDS = 180
local SAVE_EVERY = 60
local Profiles = { Sessions = {}, store = nil, running = true }

local function defaults()
	return { schema = 1, xp = 0, wins = 0, bestWave = 0, kills = 0, matches = 0 }
end

local function sanitize(value)
	local result = defaults()
	if type(value) == "table" then
		for key, defaultValue in pairs(result) do
			local n = value[key]
			if type(n) == "number" and n == n and n &gt;= 0 and n &lt; 1e12 then
				result[key] = math.floor(n)
			else
				result[key] = defaultValue
			end
		end
	end
	return result
end

local function retry(callback)
	local lastError
	for attempt = 1, 3 do
		local ok, result = pcall(callback)
		if ok then return true, result end
		lastError = result
		if attempt &lt; 3 then task.wait(0.8 * 2 ^ (attempt - 1) + math.random() * 0.2) end
	end
	return false, lastError
end

function Profiles:Init()
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then self.store = store end
	task.spawn(function()
		while self.running do
			task.wait(SAVE_EVERY)
			for player, session in pairs(self.Sessions) do
				task.spawn(function()
					if self.Sessions[player] ~= session or session.closed then return end
					local saved = self:Save(player, false)
					if session.lost then
						player:Kick("Профиль открыт на другом сервере. Подключитесь снова через минуту.")
					elseif not saved then
						warn("[Profiles] Autosave failed for", player.UserId)
					end
				end)
			end
		end
	end)
end

function Profiles:Load(player)
	local session = {
		data = defaults(), canSave = false, status = "loading", dirty = false,
		busy = false, closed = false, lost = false,
		lockId = HttpService:GenerateGUID(false),
	}
	self.Sessions[player] = session
	if RunService:IsStudio() or not self.store then
		session.status = "local"
		return session
	end
	local lockedByOther = false
	local ok, record = retry(function()
		return self.store:UpdateAsync("u_" .. player.UserId, function(old)
			lockedByOther = false
			-- PlayerRemoving may run while the initial UpdateAsync is in flight.
			if session.closed then return nil end
			if type(old) == "table" and type(old.lock) == "table"
				and old.lock.id ~= session.lockId and (old.lock.expires or 0) &gt; os.time() then
				lockedByOther = true
				return nil
			end
			local data = sanitize(old)
			data.lock = { id = session.lockId, expires = os.time() + LOCK_SECONDS }
			return data
		end)
	end)
	if self.Sessions[player] ~= session or session.closed then
		-- If the lock was acquired just before disconnect, release only that lock.
		if ok and type(record) == "table" and type(record.lock) == "table" and record.lock.id == session.lockId then
			pcall(function()
				self.store:UpdateAsync("u_" .. player.UserId, function(old)
					if type(old) == "table" and type(old.lock) == "table" and old.lock.id == session.lockId then
						local data = sanitize(old)
						data.lock = nil
						return data
					end
					return nil
				end)
			end)
		end
		return session
	end
	if lockedByOther then
		session.status = "locked"
		player:Kick("Твой профиль ещё закрывается на другом сервере. Подожди минуту и попробуй снова.")
	elseif ok and type(record) == "table" and type(record.lock) == "table" and record.lock.id == session.lockId then
		session.data = sanitize(record)
		session.canSave = true
		session.status = "saved"
	else
		session.status = "unavailable"
		warn("[Profiles] Load failed; writes disabled for", player.UserId, record)
	end
	return session
end

function Profiles:Get(player)
	local session = self.Sessions[player]
	return session and session.data or defaults()
end

function Profiles:Add(player, fields)
	local session = self.Sessions[player]
	if not session then return end
	for key, amount in pairs(fields) do
		if session.data[key] ~= nil and type(amount) == "number" and amount &gt;= 0 then
			session.data[key] = math.min(1e11, session.data[key] + math.floor(amount))
			session.dirty = true
		end
	end
end

function Profiles:Best(player, wave)
	local session = self.Sessions[player]
	if session and wave &gt; session.data.bestWave then
		session.data.bestWave = wave
		session.dirty = true
	end
end

function Profiles:Save(player, release)
	local session = self.Sessions[player]
	if not session then return true end
	if release then session.closed = true end
	if not session.canSave then
		if release then self.Sessions[player] = nil end
		return session.status == "local"
	end
	local deadline = os.clock() + 12
	while session.busy and os.clock() &lt; deadline do task.wait(0.05) end
	if session.busy then return false end
	session.busy = true
	local snapshot = table.clone(session.data)
	snapshot.lock = { id = session.lockId, expires = os.time() + LOCK_SECONDS }
	if release then snapshot.lock = nil end
	local ok, result = retry(function()
		return self.store:UpdateAsync("u_" .. player.UserId, function(old)
			if type(old) ~= "table" or type(old.lock) ~= "table" or old.lock.id ~= session.lockId then
				session.lost = true
				return nil
			end
			return snapshot
		end)
	end)
	local success = ok and type(result) == "table" and not session.lost
	session.busy = false
	if success then
		session.dirty = false
		session.status = "saved"
	elseif session.lost then
		session.canSave = false
		session.status = "lost"
	end
	if release then
		-- Keep a lost session marked so a late autosave cannot resurrect it.
		if not session.lost then self.Sessions[player] = nil end
	elseif not success then
		session.status = "unavailable"
	end
	return success
end

function Profiles:Shutdown()
	self.running = false
	local pending = 0
	for player in pairs(self.Sessions) do
		pending += 1
		task.spawn(function()
			self:Save(player, true)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 25
	while pending &gt; 0 and os.clock() &lt; deadline do task.wait(0.1) end
end

return Profiles
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX19">
            <Properties>
              <string name="Name">Towers</string>
              <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Models = require(script.Parent.Models)
local Map = require(script.Parent.Map)
local Towers = { ByPad = {}, folder = nil }

function Towers:Init(folder)
	self.folder = folder
end

function Towers:CreateModel(tower)
	if tower.model then tower.model:Destroy() end
	local pad = Map.Pads[tower.padId]
	local model, head = Models.Tower(tower.kind, tower.level, pad.position, tower.padId)
	tower.model, tower.head = model, head
	model.Parent = self.folder
	pad.model = model
	pad.part:SetAttribute("TowerType", tower.kind)
	pad.part:SetAttribute("Level", tower.level)
	pad.part:SetAttribute("OwnerId", tower.ownerId)
	pad.part:SetAttribute("OwnerName", tower.ownerName)
	pad.part:SetAttribute("Invested", tower.invested)
	pad.part:SetAttribute("Priority", tower.priority)
	pad.top.Color = Config.Towers[tower.kind].color:Lerp(Color3.fromRGB(30, 45, 55), 0.65)
	pad.label.TextTransparency = 1
end

function Towers:Build(padId, kind, player)
	local pad = Map.Pads[padId]
	if not pad or pad.model then return nil end
	local tower = {
		padId = padId, kind = kind, level = 1, ownerId = player.UserId,
		ownerName = player.DisplayName, invested = Config.Towers[kind].cost,
		cooldown = 0.15, priority = "First", position = pad.position,
	}
	self.ByPad[padId] = tower
	self:CreateModel(tower)
	return tower
end

function Towers:Upgrade(padId)
	local tower = self.ByPad[padId]
	if not tower or tower.level &gt;= 4 then return false end
	tower.level += 1
	self:CreateModel(tower)
	return true
end

function Towers:Remove(padId)
	local tower = self.ByPad[padId]
	if not tower then return end
	if tower.model then tower.model:Destroy() end
	local pad = Map.Pads[padId]
	pad.model = nil
	pad.part:SetAttribute("TowerType", "")
	pad.part:SetAttribute("OwnerId", 0)
	pad.part:SetAttribute("OwnerName", "")
	pad.part:SetAttribute("Level", 0)
	pad.part:SetAttribute("Invested", 0)
	pad.top.Color = Color3.fromRGB(77, 103, 105)
	pad.label.TextTransparency = 0.15
	self.ByPad[padId] = nil
end

function Towers:Clear()
	for padId in pairs(self.ByPad) do self:Remove(padId) end
	if self.folder then self.folder:ClearAllChildren() end
	Map.ResetPads()
end

function Towers:Update(dt, enemies, emit, now)
	for _, tower in pairs(self.ByPad) do
		tower.cooldown -= dt
		if tower.cooldown &lt;= 0 then
			local def = Config.Towers[tower.kind]
			local stats = Config.Stats(tower.kind, tower.level)
			local target = enemies:Choose(tower.position, stats.range, def.air, tower.priority)
			if target then
				tower.cooldown = stats.interval
				local headPosition = tower.position + Vector3.new(0, 3.45, 0)
				local flatTarget = Vector3.new(target.position.X, headPosition.Y, target.position.Z)
				if (flatTarget - headPosition).Magnitude &gt; 0.01 then
					tower.head:PivotTo(CFrame.lookAt(headPosition, flatTarget))
				end
				local origin = headPosition + Vector3.new(0, 0.4, 0)
				local targetPosition = target.position
				emit({ kind = tower.kind, from = origin, to = targetPosition, color = def.color, radius = stats.splash })
				if tower.kind == "Cannon" then
					for _, enemy in ipairs(enemies:InRadius(targetPosition, stats.splash, false)) do
						local falloff = 1 - math.min(0.35, (enemy.position - targetPosition).Magnitude / stats.splash * 0.35)
						enemies:Damage(enemy, stats.damage * falloff, tower.ownerId)
					end
				elseif tower.kind == "Tesla" then
					local hit = {}
					local current = target
					for jump = 1, stats.chains + 1 do
						if not current or current.dead then break end
						local previousPosition = current.position
						hit[current.id] = true
						enemies:Damage(current, stats.damage * 0.78 ^ (jump - 1), tower.ownerId)
						local nextEnemy, nearest = nil, def.chainRange ^ 2
						if jump &lt;= stats.chains then
							for _, candidate in ipairs(enemies:Candidates(previousPosition, def.chainRange, true)) do
								if not hit[candidate.enemy.id] and candidate.distance &lt; nearest then
									nextEnemy, nearest = candidate.enemy, candidate.distance
								end
							end
						end
						if nextEnemy then emit({ kind = "Chain", from = previousPosition, to = nextEnemy.position, color = def.color }) end
						current = nextEnemy
					end
				else
					if tower.kind == "Frost" then enemies:Slow(target, def.slow, stats.slowTime, now) end
					enemies:Damage(target, stats.damage, tower.ownerId)
				end
			else
				tower.cooldown = 0
			end
		end
	end
end

return Towers
</ProtectedString>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
    <Item class="StarterPlayer" referent="RBX20">
      <Properties>
        <string name="Name">StarterPlayer</string>
      </Properties>
      <Item class="StarterPlayerScripts" referent="RBX21">
        <Properties>
          <string name="Name">StarterPlayerScripts</string>
        </Properties>
        <Item class="Folder" referent="RBX22">
          <Properties>
            <string name="Name">Client</string>
          </Properties>
